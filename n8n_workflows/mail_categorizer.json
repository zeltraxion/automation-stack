    },
    {
      "parameters": {
        "inputText": "=From: {{ $json.From }}\nSubject: {{ $json.Subject }}\n{{ $json.body }}\n{{ $json.senderHint }}",
        "categories": {
          "categories": [
            {
              "category": "security",
              "description": "Account security and access. Login alerts, new device sign-ins, password resets, verification codes, one-time passwords, sign-in codes, email confirmations, 2FA codes, suspicious activity, breach notices. Also third-party apps, OAuth applications or connected services being granted access to an account. Any email containing a code used to log in or verify identity belongs here. Also warnings that an account, project, subscription or stored data will be suspended, deleted, expire or be permanently lost unless the user acts by a date. If the email is asking for a payment or a renewal, it is bills, not security."
            },
            {
              "category": "bills",
              "description": "Money owed or paid. Invoices, receipts, payment confirmations, subscription renewals, due dates, bank and card statements. An order confirmation from a shop is orders, even though it involves a payment."
            },
            {
              "category": "job_interview",
              "description": "A job process needing the user at a time or place. Interview invitations, scheduling links, assessments or tests to complete, availability requests, call logistics."
            },
            {
              "category": "job_application",
              "description": "Status of a job the user applied to, with nothing to schedule. Application received, under review, moved to next stage. Or a named human recruiter writing from a company address about a specific role. Never a job board."
            },
            {
              "category": "job_rejected",
              "description": "An explicit rejection. The text must clearly state the user was not selected - \"unfortunately\", \"not moving forward\", \"other candidates\", \" decided not to proceed \". If unsure, this is not the category."
            },
            {
              "category": "job_alert",
              "description": "Automated job listings sent in bulk. Job boards and careers systems - Glassdoor, LinkedIn, Naukri, Indeed, Monster, Capgemini. Mail from a job board is job_alert even when the subject is personalised, names one company, or says the user would be a great fit. The email must contain actual job openings or roles to apply to. Conferences, events, courses and training promotions are not job_alert. A notification that a person messaged, connected with, viewed or reacted to the user on a social or professional network is not job_alert, even when it comes from a job board's domain."
            },
            {
              "category": "newsletter",
              "description": "Bulk content and marketing. Blogs, digests, product updates, promotions, offers, event invitations, announcements. Includes promotional mail from banks, apps and services the user already uses - new features, app downloads, branch hours, offers. Nothing is required of the user. Not transactional notices about the user's own account activity, balances, or usage."
            },
            {
              "category": "general",
              "description": "Fits none of the above. Mail from a real person, or a one-off transactional notice about something the user did. Not marketing."
            },
            {
              "category": "orders",
              "description": "A specific purchase the user made from a shop. Order confirmation, dispatch or shipping notice, out for delivery, delivered, return, exchange or refund status, cancellation. Amazon, Flipkart, Myntra, Swiggy, Zomato, Blinkit. Not promotional mail from a shop, that is newsletter."
            }
          ]
        },
        "options": {
          "multiClass": false,
          "fallback": "other",
          "systemPromptTemplate": "You classify emails for a personal inbox. Classify the text provided by the user into one of the following categories: {categories}, and use the provided formatting instructions below. Don't explain, and only output the json.\n\nRules:\n- If the email concerns a job the user applied to, prefer a job_ category over general or newsletter.\n- Only choose job_rejected when the text explicitly states the user was not selected.\n- If the email asks the user to attend, schedule, or complete something by a date, prefer job_interview over job_application.\n- If two categories fit equally well, choose the one that keeps the email more visible.\n- Promotional or marketing mail is newsletter, even when sent by a bank or a service the user already uses.\n- An email containing a verification code, one-time password or sign-in code is always security.\n- If a line describes past mail from this sender, prefer that category unless this email clearly differs from it.",
          "batching": {
            "batchSize": 1
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
