    {
      "parameters": {
        "jsCode": "const fileText = $input.first().json.data ?? '';\nconst switches = {};\n\n// The properties block is everything between the first pair of --- lines.\nconst frontmatter = fileText.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---/);\n\nif (frontmatter) {\n  for (const line of frontmatter[1].split(/\\r?\\n/)) {\n\n    // Split \"switch_name: true/false\" into a name and a value.\n    const parts = line.match(/^([\\w-]+):\\s*(.*)$/);\n    if (!parts) continue;\n\n    const name = parts[1];\n    let value = parts[2].trim();\n\n    if (value === 'true') value = true;\n    else if (value === 'false') value = false;\n\n    switches[name] = value;\n  }\n}\n\n// Which switch the caller asked about.\nconst asked = $('When Executed by Another Workflow').first().json.workflow;\n\n// Fail open: only an explicit false pauses. Missing file, missing property,\n// unreadable vault - all run.\nreturn [{ json: { workflow: asked, enabled: switches[asked] !== false } }];"
      },
