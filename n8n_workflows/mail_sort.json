    {
      "parameters": {
        "jsCode": "const seen = new Set(); // Empty list of emails already handled\nconst out = []; // Empty basket for finished emails\n\n/**\n * Every email from all nine branches\n * Go through them one by one\n * \"item\" = current email\n */\nfor (const item of $input.all()) {\n  const id = item.json.id; // Grab this mail's Gmail ID\n\n  /**\n   * One email can come out of two branches, Keep first\n   * if this mail ID already seen = skip and continue\n   * otherwise add to set\n   */\n  if (seen.has(id)) continue;\n  seen.add(id);\n\n  /**\n   * List of tags\n   * \"sorted\" -> every email came out of two branches earlier\n   */\n  const labels = ['Label_11'] // \"sorted\", always\n\n  /**\n   * Did cat_* node put label ID on the mail?\n   * yes = add to list\n   * cat_other leaves it empty\n   * undecided emails get only sorted, no category tag\n   */\n  if (item.json.labelId) labels.push(item.json.labelId);\n\n\n  /**\n   * Put email in basket\n   * \"...item.json\" -> spread operator\n   * new field added = labelsToAdd\n   */\n  out.push({json: {...item.json, labelsToAdd: labels} });\n  \n}\n\nreturn out; // Get basket to pass to next node"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1104,
        928
      ],
      "id": "415833c2-e712-4fa1-92fa-07f46234a562",
      "name": "dedupe_and_flag"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -3136,
        1024
      ],
      "id": "66f74629-1584-43d1-9139-2fb0fc45b4d6",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "const map = $('build_sender_map').first().json.senderMap ?? {};\n\nreturn $input.all().map(item => {\n  const j = item.json;\n\n  const body = (j.text ?? '')\n    .replace(/https?:\\/\\/\\S+/g, '')   // tracking links, no signal, lots of tokens\n    .replace(/\\s+/g, ' ')             // collapse the newline soup\n    .trim()\n    .slice(0, 700);                   // enough to reach the actual point\n\n  const From = j.from?.text ?? '';\n\n  // Same address extraction as build_sender_map, so the keys match\n  const addr = From.match(/[\\w.+-]+@[\\w.-]+/)?.[0]?.toLowerCase();\n  const hit = addr ? map[addr] : null;\n\n  const senderHint = hit\n    ? `Past mail from this sender: ${hit.n} of ${hit.total} were ${hit.top}.`\n    : '';\n\n  return{\n    json: {\n      id: j.id,\n      threadId: j.threadId,\n      labelIds: j.labelIds,\n      internalDate: j.date,\n      Subject: j.subject,\n      From,\n      body,\n      senderHint,\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2256,
        944
      ],
      "id": "738b83b9-3c80-46dd-b987-7841c8a4106f",
      "name": "trim_body"
    },
    {
