      "id": "2701b919-8169-4863-a6f4-c950e4f22836",
      "name": "history_lookup",
      "webhookId": "408271f7-1f51-4df1-aa4e-dc190f02d124",
      "credentials": {
        "gmailOAuth2": {
          "id": "mjM40zjHqlK2BaBE",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const counts = {};   // sender -> { category -> count }\n\nfor (const item of $input.all()) {\n  // \"Glassdoor Jobs <noreply@glassdoor.com>\" -> \"noreply@glassdoor.com\"\n  const from = (item.json.From ?? '').match(/[\\w.+-]+@[\\w.-]+/)?.[0]?.toLowerCase();\n  if (!from) continue;\n\n  for (const l of item.json.labels ?? []) {\n    // Ours all have Label_ ids. INBOX / UNREAD / CATEGORY_* don't. sorted is plumbing.\n    if (!l.id.startsWith('Label_') || l.name === 'sorted') continue;\n\n    // \"jobs/alert\" -> \"job_alert\", to match the classifier's category names\n    const cat = l.name.startsWith('jobs/') ? 'job_' + l.name.slice(5) : l.name;\n\n    counts[from] ??= {};\n    counts[from][cat] = (counts[from][cat] ?? 0) + 1;\n  }\n}\n\nconst senderMap = {};\n\nfor (const [from, byCat] of Object.entries(counts)) {\n  const [top, n] = Object.entries(byCat).sort((a, b) => b[1] - a[1])[0];\n  const total = Object.values(byCat).reduce((s, x) => s + x, 0);\n\n  // Needs real history and clear agreement before we trust it\n  if (total >= 3 && n / total >= 0.8) senderMap[from] = { top, n, total };\n}\n\nreturn [{ json: { senderMap } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
