      "id": "74fedf1f-b3af-433f-83c8-ae4770440bf9",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.data;\nconst props = {};\n\nconst match = text.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---/);\n\nif (match) {\n  for (const line of match[1].split(/\\r?\\n/)) {\n    const kv = line.match(/^([\\w-]+):\\s*(.*)$/);\n    if (!kv) continue;\n\n    let v = kv[2].trim().replace(/^[\"'](.*)[\"']$/, '$1');\n    if (v === 'true') v = true;\n    else if (v === 'false') v = false;\n    else if (v === '') v = null;\n    else if (/^-?\\d+(\\.\\d+)?$/.test(v)) v = Number(v);\n\n    props[kv[1]] = v;\n  }\n}\n\nreturn [{ json: props }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        64
      ],
      "id": "da6f24e9-c9c7-4dbd-a413-f1d738cabb01",
      "name": "Get Contents"
    },
    {
      "parameters": {
        "jsCode": "const c = $json;\nconst now = $now.toFormat('yyyy-LL-dd HH:mm');\n\nconst row = (name, on) => `| ${name} | ${on ? '🟢 on' : '🔴 off'} |`;\n\nconst md = `---\ngenerated_at: ${now}\n---\n\n# Status\n\n| Service | State |\n|---|---|\n${row('Backup', c.backup_enabled)}\n${row('Daily summary', c.daily_summary_enabled)}\n\n_Written by n8n — do not edit by hand._\n`;\n\nreturn [{ json: { md } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
