# =========================
# n8n / local runtime secrets
# =========================
.env
.env.*

# n8n runtime data and local state
.n8n/
.n8n/**
n8n_data/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Workflow exports are often committed intentionally; keep them out of the ignore list
# unless you intentionally want them generated locally only.

# =========================
# Node / package artifacts
# =========================
node_modules/
custom-nodes/**/node_modules/
custom-nodes/**/dist/
custom-nodes/**/*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Logs and temp data
# =========================
*.log
logs/
tmp/
temp/
.cache/

# =========================
# Docker / local environment
# =========================
docker-compose.override.yml
.volumes/

# =========================
# Editor and OS files
# =========================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# =========================
# Custom n8n local build output
# =========================
build/
coverage/

# =========================
# Generated analysis output
# =========================
# graphify rebuilds this from the repo on demand. Same reasoning as build/.
graphify-out/

# =========================
# Claude Code local settings
# =========================
# `graphify claude install` writes PreToolUse hooks here using an ABSOLUTE path
# to the graphify binary, so the file only works on the machine that generated
# it. Ignored rather than committed — re-create with `graphify claude install`.
.claude/settings.json
__pycache__/
*.pyc
